100C  8D 8D 8D 8D  hiasc "\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\rENTER G FOR GAME OR I FOR INSTRUCTIONS"
1045  00           .byte $00
1046  20 6F FD     JSR GETLN1
1049  AD 00 02     LDA input_buffer
104C  C9 C7        CMP #'G'|$80
104E  D0 03        BNE start__not_game
1050  4C 7B 1B     JMP run_adventure
1053  C9 C9        CMP #'I'|$80
1055  F0 03        BEQ show_instructions
